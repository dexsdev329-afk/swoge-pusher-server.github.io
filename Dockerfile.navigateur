# Le navigateur de SWOGE Agents : un service Railway A PART (voir navigateur_serveur.js).
# Sur le service Railway : RAILWAY_DOCKERFILE_PATH=Dockerfile.navigateur (documentation Railway,
# « Dockerfiles », relue le 30/09/2026), NAVIGATEUR_SECRET = le meme que sur le serveur du jeu.
# Image officielle Playwright 1.56.1 (tag verifie sur mcr.microsoft.com le 30/09/2026) : Chromium et
# ses dependances systeme y sont deja, sous /ms-playwright ; meme version que les essais.
FROM mcr.microsoft.com/playwright:v1.56.1-noble
WORKDIR /app
RUN npm init -y >/dev/null && npm install --omit=dev --no-audit --no-fund playwright-core@1.56.1
COPY navigue.js ./
# 02/10 : le ticket et le filtre des gestes, le meme code que le serveur du jeu (liaison directe).
COPY navigateur_direct.js ./
# Sous le nom server.js : Railway lance la commande du Procfile du depot (« web: node server.js »)
# meme quand il construit avec ce Dockerfile — constate le 01/10 au premier deploiement
# (« Cannot find module '/app/server.js' »). Le navigateur demarre donc quelle que soit la commande.
COPY navigateur_serveur.js ./server.js
ENV NODE_ENV=production
CMD ["node", "server.js"]
